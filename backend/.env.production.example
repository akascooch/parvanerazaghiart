# Backend production env template — copy via scripts/init-prod-env.sh
# Never commit a filled .env.production
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/parvanerazaghiart?schema=public
JWT_SECRET=generate-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-64-different
MEDIA_SIGNING_SECRET=generate-with-openssl-rand-hex-64-different
INQUIRY_HASH_SECRET=generate-with-openssl-rand-hex-64-different
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://parvanerazaghiart.com
MEDIA_ROOT=./storage/media
