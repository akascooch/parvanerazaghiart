# Backend environment template — copy to .env and fill values
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/parvanerazaghiart?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Local media files stay outside the public web root
MEDIA_ROOT=./storage/media
# Optional dedicated HMAC for public gallery image URLs (falls back to JWT_SECRET)
# MEDIA_SIGNING_SECRET=change-me-to-a-long-random-string

# Optional dedicated HMAC for hashing enquiry IPs (falls back to JWT_SECRET)
# INQUIRY_HASH_SECRET=change-me-to-a-long-random-string

# Seeded local admin (used by prisma/seed.cjs — never commit real .env)
ADMIN_EMAIL=admin@localhost
ADMIN_PHONE=09XXXXXXXXX
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Gallery Admin

# Optional: local Prisma engines when binaries.prisma.sh is unreachable
# PRISMA_ENGINES_CHECKSUM_IGNORE_CHECKS=1
# PRISMA_QUERY_ENGINE_LIBRARY=./prisma-engines-manual/query_engine.dll.node
# PRISMA_SCHEMA_ENGINE_BINARY=./prisma-engines-manual/schema-engine.exe
