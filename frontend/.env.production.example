# Frontend production env — generated by scripts/init-prod-env.sh
# NEXT_PUBLIC_API_URL is the Nest loopback URL used by Next server/BFF.
# Browsers call same-origin /api/* on Next, never this address.
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api
NEXT_PUBLIC_SITE_URL=https://parvanerazaghiart.com
